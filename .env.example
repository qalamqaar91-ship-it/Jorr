# ---- Frontend (safe to expose: anon key is protected by RLS) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only (Netlify functions). NEVER prefix with VITE_ ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# One-time admin setup. Use a long random value; delete both after setup.
ADMIN_SETUP_SECRET=
ADMIN_SETUP_EMAIL=
